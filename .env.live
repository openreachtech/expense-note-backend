## DATABASE

DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_DIALECT=
DATABASE_HOST=
DATABASE_PORT=

## AUTH
# Access-token lifetime is a fixed 15-minute module constant (not env-driven); only the
# refresh-token lifetime and the cookie attributes are configurable here.
# Secure cookies require TLS — over plain HTTP the browser drops them.

AUTH_REFRESH_TOKEN_TTL_DAYS=
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAME_SITE=
AUTH_COOKIE_PATH=
AUTH_COOKIE_DOMAIN=

## CORS
# Origins allowed to read a response from the staff GraphQL endpoint, comma separated.
# REQUIRED WHEN the staff screens are served from a different origin than /graphql-staff.
# Left unset this denies every cross-origin reader, which fails safe but blocks such a
# deployment until it is set. Same origin needs nothing here.
# Never `*`: the value is matched element by element, so a literal asterisk matches no
# origin and denies everything -- it is not a wildcard through this key. The wildcard in
# `cors` comes from omitting the origin option entirely, which the engine never does.

STAFF_CORS_ALLOWED_ORIGINS=
