## DATABASE

DATABASE_NAME=development
DATABASE_USERNAME=user
DATABASE_PASSWORD=password
DATABASE_DIALECT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

## AUTH
# Access-token lifetime is a fixed 15-minute module constant (not env-driven); only the
# refresh-token lifetime and the cookie attributes are configurable here.

AUTH_REFRESH_TOKEN_TTL_DAYS=14
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=

## CORS
# Origins allowed to read a response from the staff GraphQL endpoint, comma separated.
# A missing or misspelled key allows no cross-origin reader at all -- never a wildcard. The
# library treats an empty string and a null as "allow any", so the engine always builds an
# array, and an empty array sets no Access-Control-Allow-Origin.

STAFF_CORS_ALLOWED_ORIGINS=http://localhost:3000
